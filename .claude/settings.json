{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/genexus_grounding.py\" || true",
            "timeout": 10,
            "statusMessage": "Anclando respuesta en el corpus GeneXus..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/genexus_validate.py\" || true",
            "timeout": 10,
            "statusMessage": "Validando codigo GeneXus contra el catalogo..."
          }
        ]
      }
    ]
  }
}
